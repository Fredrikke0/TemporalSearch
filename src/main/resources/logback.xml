<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Suppress internal Logback status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Main File Appender (for general application logs) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/indexer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/indexer.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory> <!-- Keep 10 days of logs -->
            <totalSizeCap>3GB</totalSizeCap> <!-- Max total size of log files -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Metrics File Appender (optional, if you want separate metrics) -->
    <appender name="METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/metrics.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- Metrics might have a simpler pattern, e.g., just the message if it\'s structured -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Specific logger for metrics (optional) -->
    <logger name="com.example.logging.IndexingMetrics" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE"/>
    </logger>

    <!-- Suppress non-critical messages from noisy libraries -->
    <logger name="com.example.index.LevelDBConfig" level="WARN"/>
    <logger name="edu.stanford.nlp" level="WARN"/>
    <logger name="org.iq80.leveldb" level="WARN"/> <!-- For LevelDB itself -->
    <logger name="org.xerial.snappy" level="WARN"/> <!-- For Snappy compression -->
    <!-- Add any other noisy libraries here -->


    <!-- Root logger configuration -->
    <!-- This level applies to all loggers unless overridden by a more specific logger above. -->
    <!-- All logs from com.example.* (except IndexingMetrics if configured above) will use this. -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
