<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/indexer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/indexer.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="METRICS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/metrics.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Specific logger for metrics -->
    <logger name="com.example.logging.IndexingMetrics" level="INFO" additivity="false">
        <appender-ref ref="METRICS"/>
    </logger>

    <!-- Suppress LevelDB configuration messages -->
    <logger name="com.example.index.LevelDBConfig" level="WARN"/>

    <!-- Suppress verbose Stanford CoreNLP initialization messages -->
    <logger name="edu.stanford.nlp" level="WARN"/>

    <!-- Set root logger level to INFO -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="METRICS"/>
    </root>

    <!-- Keep specific loggers if needed, otherwise INFO will apply -->
    <logger name="com.example.performance" level="INFO" additivity="false">
        <appender-ref ref="PERFORMANCE"/>
    </logger>
    <logger name="com.example.index" level="INFO" additivity="false">
         <appender-ref ref="CONSOLE"/> 
         <appender-ref ref="FILE"/> 
    </logger>
    <logger name="com.example.query" level="DEBUG" additivity="false"> 
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>
    <logger name="com.example.core" level="INFO" additivity="false"> 
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>
</configuration>
