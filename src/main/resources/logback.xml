<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Suppress internal Logback status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Pipeline Command File Appender (logs only command invocation + timing) -->
    <appender name="PIPELINE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/indexer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/indexer.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Metrics File Appender (optional, if you want separate metrics) -->
    <appender name="METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/metrics.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>10</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- Metrics might have a simpler pattern, e.g., just the message if it\'s structured -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Specific logger for Pipeline command logging (command + flags + timing only) -->
    <logger name="com.example.Pipeline.command" level="INFO" additivity="false">
        <appender-ref ref="PIPELINE_FILE"/>
    </logger>

    <!-- Specific logger for metrics -->
    <logger name="com.example.logging.IndexingMetrics" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE"/>
    </logger>

    <!-- Suppress non-critical messages from noisy libraries -->
    <logger name="com.example.index.RocksDBConfig" level="WARN"/>
    <logger name="edu.stanford.nlp" level="ERROR"/>
    <logger name="org.rocksdb" level="WARN"/>
    <logger name="org.xerial.snappy" level="WARN"/> <!-- For Snappy compression -->
    <logger name="sutime" level="ERROR"/>
    <!-- Add any other noisy libraries here -->


    <!-- Root logger configuration -->
    <!-- Only logs to console. Individual loggers above handle file output. -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
