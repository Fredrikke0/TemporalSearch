package com.example.index.generators.stitch;

import java.io.IOException;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.stream.Collectors;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import com.example.core.IndexAccessInterface;
import com.example.index.AnnotationType;
import com.example.index.generators.POSIndexGenerator;
import com.example.index.util.SynonymManager;
import com.example.logging.ProgressTracker;

public final class SqlUnigramPosStitchIndexGenerator extends AbstractNgramStitchGenerator {
    private static final Logger logger = LoggerFactory.getLogger(SqlUnigramPosStitchIndexGenerator.class);
    public static final String MY_INDEX_NAME = "stitch_sql_unigram_pos";

    private static final int SQL_DOCUMENT_BATCH_SIZE = 100;
    private Integer sqlQueryLastProcessedDocumentId = null;
    private static final String TEMP_STOPWORDS_TABLE_NAME = "temp_stitch_stopwords";

    public SqlUnigramPosStitchIndexGenerator(
            IndexAccessInterface indexAccess,
            String stopwordsPath,
            Connection sqliteConn,
            ProgressTracker progress,
            int batchSize,
            Path customTempPath,
            SynonymManager sharedSynonymManager) throws IOException {
        super(1,
              indexAccess,
              stopwordsPath,
              sqliteConn,
              progress,
              batchSize,
              customTempPath,
              sharedSynonymManager,
              AnnotationType.POS);
        logger.info("SqlUnigramPosStitchIndexGenerator initialized. Internal SQL processing batch size for documents: {}. Output NgramStitchEntry batch size: {}. Stopwords: '{}'",
            SQL_DOCUMENT_BATCH_SIZE, batchSize, stopwordsPath != null && !stopwordsPath.isEmpty() ? stopwordsPath : "none");
    }

    @Override
    protected void populateSpecificAnnotationSynonyms(AnnotationType type) throws SQLException, IOException {
        if (type != AnnotationType.POS) {
            throw new IllegalArgumentException("SqlUnigramPosStitchIndexGenerator's populateSpecificAnnotationSynonyms called with incorrect type: " + type);
        }
        logger.debug("populateSpecificAnnotationSynonyms for SqlUnigramPosStitchIndexGenerator. Specific POS annotation values (tokens) will have IDs fetched on-the-fly.");
    }

    @Override
    protected List<AnnotationData> fetchAnnotationsForDocument(int documentId) throws SQLException {
        logger.warn("fetchAnnotationsForDocument called on {} for docId {}. This method is unused due to fetchBatch override. Returning empty list.", getIndexName(), documentId);
        return Collections.emptyList();
    }

    @Override
    protected void processDocument(int documentId, List<NgramStitchEntry> entries) throws SQLException {
        throw new UnsupportedOperationException("processDocument should not be called directly when fetchBatch is overridden in SqlUnigramPosStitchIndexGenerator.");
    }

    private void createAndPopulateTempStopwordsTable() throws SQLException {
        try (Statement stmt = sqliteConn.createStatement()) {
            stmt.executeUpdate("DROP TABLE IF EXISTS " + TEMP_STOPWORDS_TABLE_NAME);
            stmt.executeUpdate("CREATE TEMP TABLE " + TEMP_STOPWORDS_TABLE_NAME + " (word TEXT PRIMARY KEY)");
            logger.debug("Created temporary stopwords table: {}", TEMP_STOPWORDS_TABLE_NAME);
        }

        if (stopwords != null && !stopwords.isEmpty()) {
            String insertSql = "INSERT OR IGNORE INTO " + TEMP_STOPWORDS_TABLE_NAME + " (word) VALUES (?)";
            try (PreparedStatement pstmt = sqliteConn.prepareStatement(insertSql)) {
                for (String stopword : stopwords) {
                    pstmt.setString(1, stopword.toLowerCase());
                    pstmt.addBatch();
                }
                pstmt.executeBatch();
                logger.debug("Populated {} stopwords into temporary table {}", stopwords.size(), TEMP_STOPWORDS_TABLE_NAME);
            }
        } else {
            logger.debug("No stopwords to populate into temporary table {}", TEMP_STOPWORDS_TABLE_NAME);
        }
    }

    private void dropTempStopwordsTable() {
        try (Statement stmt = sqliteConn.createStatement()) {
            stmt.executeUpdate("DROP TABLE IF EXISTS " + TEMP_STOPWORDS_TABLE_NAME);
            logger.debug("Dropped temporary stopwords table: {}", TEMP_STOPWORDS_TABLE_NAME);
        } catch (SQLException e) {
            logger.warn("Failed to drop temporary stopwords table '{}': {}", TEMP_STOPWORDS_TABLE_NAME, e.getMessage());
        }
    }

    @Override
    protected List<NgramStitchEntry> fetchBatch(NgramStitchEntry lastStitchEntryFromPreviousOverallBatch) throws SQLException {
        List<Integer> documentIdsToProcess = new ArrayList<>();
        String docIdQuery;
        if (this.sqlQueryLastProcessedDocumentId == null) {
            docIdQuery = "SELECT document_id FROM documents ORDER BY document_id LIMIT ?";
        } else {
            docIdQuery = "SELECT document_id FROM documents WHERE document_id > ? ORDER BY document_id LIMIT ?";
        }

        try (PreparedStatement docStmt = sqliteConn.prepareStatement(docIdQuery)) {
            if (this.sqlQueryLastProcessedDocumentId == null) {
                docStmt.setInt(1, SQL_DOCUMENT_BATCH_SIZE);
            } else {
                docStmt.setInt(1, this.sqlQueryLastProcessedDocumentId);
                docStmt.setInt(2, SQL_DOCUMENT_BATCH_SIZE);
            }
            try (ResultSet docRs = docStmt.executeQuery()) {
                while (docRs.next()) {
                    documentIdsToProcess.add(docRs.getInt("document_id"));
                }
            }
        }

        if (documentIdsToProcess.isEmpty()) {
            logger.info("No more documents to process for SQL-based POS stitch index (sqlQueryLastProcessedDocumentId: {}).", this.sqlQueryLastProcessedDocumentId);
            return Collections.emptyList();
        }
        this.sqlQueryLastProcessedDocumentId = documentIdsToProcess.get(documentIdsToProcess.size() - 1);

        List<NgramStitchEntry> currentBatchEntries = new ArrayList<>();
        if (documentIdsToProcess.isEmpty()) {
            return currentBatchEntries;
        }

        String documentIdPlaceholders = String.join(",", Collections.nCopies(documentIdsToProcess.size(), "?"));

        createAndPopulateTempStopwordsTable();

        String stitchSql = String.format("""
            WITH
            SentenceAnnotations_DocSpecific AS (
                SELECT
                    document_id, sentence_id,
                    begin_char AS annotation_begin_char,
                    end_char AS annotation_end_char,
                    UPPER(pos) AS annotation_key_component,
                    LOWER(token) AS specific_value_for_synonym
                FROM annotations
                WHERE document_id IN (%s)
                  AND pos NOT IN %s
            ),
            SentenceUnigrams_DocSpecific AS (
                SELECT
                    a.document_id, a.sentence_id,
                    LOWER(a.token) AS ngram_key,
                    a.begin_char AS ngram_begin_char,
                    a.end_char AS ngram_end_char
                FROM annotations a
                LEFT JOIN %s sw ON LOWER(a.token) = sw.word
                WHERE a.document_id IN (%s)
                  AND sw.word IS NULL
                  AND a.token GLOB '*[A-Za-z0-9]*'
            )
            SELECT
                su.document_id,
                sa.sentence_id,
                su.ngram_begin_char,
                su.ngram_end_char,
                su.ngram_key,
                sa.annotation_key_component,
                sa.specific_value_for_synonym,
                sa.annotation_begin_char,
                sa.annotation_end_char
            FROM SentenceUnigrams_DocSpecific su
            JOIN SentenceAnnotations_DocSpecific sa ON su.document_id = sa.document_id AND su.sentence_id = sa.sentence_id
            ORDER BY su.document_id, sa.sentence_id, su.ngram_begin_char, sa.annotation_begin_char;
            """, documentIdPlaceholders, POSIndexGenerator.POS_TAGS_TO_EXCLUDE_SQL,
                 TEMP_STOPWORDS_TABLE_NAME, documentIdPlaceholders);

        int stitchSqlParamIndex = 1;
        try (PreparedStatement stmt = sqliteConn.prepareStatement(stitchSql)) {
            for (Integer docId : documentIdsToProcess) {
                stmt.setInt(stitchSqlParamIndex++, docId);
            }
            for (Integer docId : documentIdsToProcess) {
                stmt.setInt(stitchSqlParamIndex++, docId);
            }

            if (logger.isTraceEnabled()) {
                 logger.trace("Executing SQL POS stitch for {} document IDs: {}", documentIdsToProcess.size(), documentIdsToProcess.stream().map(String::valueOf).collect(Collectors.joining(", ")));
            }

            try (ResultSet rs = stmt.executeQuery()) {
                while (rs.next()) {
                    String ngramKey = rs.getString("ngram_key");

                    String specificValueForSynonym = rs.getString("specific_value_for_synonym");
                    int specificValueId = -1;
                    int currentDocumentIdFromResult = rs.getInt("document_id");

                    if (requiresSynonymIdForAnnotationValue()) {
                        try {
                            specificValueId = synonymManager.getId(specificValueForSynonym);
                        } catch (IllegalArgumentException e) {
                            logger.debug("Skipping SQL-based POS stitch for document {} due to invalid specific value for synonym: '{}' - {}. Index: {}", currentDocumentIdFromResult, specificValueForSynonym, e.getMessage(), getIndexName());
                            continue;
                        } catch (org.rocksdb.RocksDBException e) {
                            logger.error("RocksDB error getting ID for specific value synonym '{}' (document {}, index {}): {}", specificValueForSynonym, currentDocumentIdFromResult, getIndexName(), e.getMessage(), e);
                            continue;
                        }
                    }

                    currentBatchEntries.add(new NgramStitchEntry(
                        currentDocumentIdFromResult,
                        rs.getInt("sentence_id"),
                        rs.getInt("ngram_begin_char"),
                        rs.getInt("ngram_end_char"),
                        ngramKey,
                        rs.getString("annotation_key_component"),
                        specificValueId,
                        rs.getInt("annotation_begin_char"),
                        rs.getInt("annotation_end_char")
                    ));
                }
            }
        } catch (SQLException e) {
            String docIdsString = documentIdsToProcess.stream().map(String::valueOf).collect(Collectors.joining(", "));
            logger.error("SQLException processing batch of {} documents for SQL POS stitch. Last SQL doc batch ID: {}. Docs: [{}]. Error: {}",
                         documentIdsToProcess.size(), this.sqlQueryLastProcessedDocumentId, docIdsString, e.getMessage(), e);
            if (logger.isDebugEnabled()) {
                logger.debug("Failed SQL for POS stitch: {}", stitchSql);
            }
            throw e;
        } finally {
            dropTempStopwordsTable();
        }

        if (currentBatchEntries.isEmpty() && !documentIdsToProcess.isEmpty()) {
             logger.trace("No SQL-based POS stitch entries from {} documents (Last SQL doc batch ID: {}, IDs: {}) ", documentIdsToProcess.size(), this.sqlQueryLastProcessedDocumentId, documentIdsToProcess.stream().map(String::valueOf).collect(Collectors.joining(", ")));
        } else if (!currentBatchEntries.isEmpty()){
            logger.debug("Generated {} SQL-based POS stitch entries from {} documents (Last SQL doc batch ID: {}, IDs: {}).", currentBatchEntries.size(), documentIdsToProcess.size(), this.sqlQueryLastProcessedDocumentId, documentIdsToProcess.stream().map(String::valueOf).collect(Collectors.joining(", ")));
        }
        return currentBatchEntries;
    }

    @Override
    protected boolean requiresSynonymIdForAnnotationValue() {
        return true;
    }

    @Override
    protected AnnotationType getManagedAnnotationType() {
        return AnnotationType.POS;
    }

    @Override
    public String getIndexName() {
        return MY_INDEX_NAME;
    }
}