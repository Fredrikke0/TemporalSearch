<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Silence the startup messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Console appender with simple pattern -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set com.example to INFO in tests to keep output clean -->
    <logger name="com.example" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Completely suppress IndexingMetrics logging during tests -->
    <logger name="com.example.logging.IndexingMetrics" level="OFF" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Suppress SqliteAccessor verbose logging during tests -->
    <logger name="com.example.query.sqlite.SqliteAccessor" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Suppress CoreNLP logging -->
    <logger name="edu.stanford.nlp" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root logger - minimal output -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
