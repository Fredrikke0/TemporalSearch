        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <build.helper.maven.plugin.version>3.5.0</build.helper.maven.plugin.version>
        <exec.maven.plugin.version>3.5.0</exec.maven.plugin.version>
        <antlr4.maven.plugin.version>4.13.2</antlr4.maven.plugin.version>
    </properties>

    <modules>
        <!-- Modules will be added here, e.g., <module>converters</module> -->
    </modules>

    <repositories>
        <repository>
            <id>clojars</id>
            <url>https://clojars.org/repo/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Stanford CoreNLP - for annotation phase -->
            <dependency>
                <groupId>edu.stanford.nlp</groupId>
                <artifactId>stanford-corenlp</artifactId>
                <version>${stanford.nlp.version}</version>
                <exclusions>
                    <!-- Exclude unused language models -->
                    <exclusion>
                        <groupId>edu.stanford.nlp</groupId>
                        <artifactId>stanford-corenlp-models-arabic</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>edu.stanford.nlp</groupId>
